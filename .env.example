# Optional CMS read access for a future separate V3 environment.
DATOCMS_API_TOKEN=
DATOCMS_ENVIRONMENT=
# V3 review defaults: analytics disabled and noindex.
PUBLIC_SITE_INDEXABLE=false
PUBLIC_ENABLE_ANALYTICS=false
# Optional server-only CRM duplication. No V2 credentials are copied.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_DEAL_PIPELINE=default
HUBSPOT_DEAL_STAGE=
# Demo-only Olivia v3.6 gateway. Server variables; never prefix with PUBLIC_.
OLIVIA_V36_GATEWAY_KEY=
OLIVIA_V36_GATEWAY_URL=https://olivia.o7digitalgroup.com/vialterna-demo
