---
import { reviewData } from '../../lib/review';
const en=Astro.url.pathname.startsWith('/en/');
const data=reviewData(Astro.url.pathname,en?'en':'es');
---
<aside class="v3-review-control" aria-label={en?'V3 change review':'Revisión de cambios V3'}>
 <button type="button" data-review-toggle aria-pressed="true" aria-describedby="v3-review-legend"><span class="v3-review-dot" aria-hidden="true"></span><span>{en?'V3 changes':'Cambios V3'}</span><span class="v3-review-state" data-review-state>{en?'On':'Sí'}</span></button>
 <p id="v3-review-legend">{en?'Yellow: new or updated copy':'Amarillo: texto nuevo o actualizado'}</p>
</aside>
<script type="application/json" is:inline id="v3-review-data" set:html={JSON.stringify(data).replaceAll('<','\\u003c')} />
<script>
 import { normalizeReviewText } from '../../lib/review-text';
 const control=document.querySelector<HTMLButtonElement>('[data-review-toggle]');
 const en=document.documentElement.lang==='en';
 const data=JSON.parse(document.getElementById('v3-review-data')?.textContent||'{"entries":[]}') as {page:string;newPage:boolean;entries:[string,string][]};
 const entries=new Map(data.entries);
 const selector='h1,h2,h3,h4,p,li,summary,label,a,.eyebrow,.kicker,.v3-platform-caption,.footer-keywords,.v3-stack-sources>div,.v3-stack-foundation,.v3-entry-link,.v3-stack-services strong';
 document.querySelectorAll<HTMLElement>(`main ${selector.split(',').join(',main ')},footer p,footer a,footer .footer-bottom span,footer .footer-keywords,[data-olivia-root] p`).forEach(element=>{
  if(element.closest('form,script,style,.v3-review-control')||element.matches('.number,.v3-step'))return;
  const normalized=normalizeReviewText(element.textContent||'');
  const state=entries.get(element.matches('summary')?normalized.replace(/^\d+\s*/,''):normalized);
  if(state)element.dataset.v3Change=state;
  else if(data.newPage&&element.closest('main'))element.dataset.v3Change='new';
 });
 // These rendered blocks adapt the document's wording rather than repeat it verbatim.
 const mark=(selector:string)=>document.querySelectorAll<HTMLElement>(selector).forEach(element=>{element.dataset.v3Change='changed';});
 if(data.page==='contact')mark('.contact-form-header :is(.kicker,h2,p),.editorial-list :is(h2,p)');
 if(data.page==='home')mark('.v3-partners p');
 if(data.page==='faq')mark('.editorial-hero :is(h1,.detail-lead)');
 document.querySelectorAll<HTMLElement>('[data-audit-form] label:not(.v3-honeypot)').forEach(label=>{label.dataset.v3Change='changed';});
 document.querySelectorAll<HTMLAnchorElement>('header a,footer a').forEach(link=>{
  const href=link.getAttribute('href')||'';
  if(/\/(cloud|edge-to-cloud)\/$/.test(href))link.dataset.v3Change='new';
  if(link.matches('.header-cta'))link.dataset.v3Change='changed';
 });
 let active=true;
 try{
  const query=new URL(location.href).searchParams.get('review');
  active=query!==null?query!=='0':localStorage.getItem('vialterna-v3-client-review')!=='off';
  if(query!==null)localStorage.setItem('vialterna-v3-client-review',active?'on':'off');
 }catch{}
 const render=()=>{
  document.documentElement.toggleAttribute('data-review-active',active);
  control?.setAttribute('aria-pressed',String(active));
  const state=control?.querySelector('[data-review-state]');
  if(state)state.textContent=active?(en?'On':'Sí'):(en?'Off':'No');
 };
 render();
 control?.addEventListener('click',()=>{
  active=!active;render();
  try{localStorage.setItem('vialterna-v3-client-review',active?'on':'off');}catch{}
  const url=new URL(location.href);url.searchParams.delete('review');history.replaceState(null,'',url);
 });
</script>
