---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Actions from './Actions.astro';
import CTA from './CTA.astro';
import Stack from './Stack.astro';
import HowWeWork from './HowWeWork.astro';
import Questions from './Questions.astro';
import Rich from './Rich.astro';
import DataStrip from './DataStrip.astro';
import { t, items, split, metadata, solutionHref, type Lang } from '../../lib/v3';
interface Props { lang: Lang }
const { lang }=Astro.props;
const key='edge-to-cloud',seo=metadata(key,lang);
---
<BaseLayout title={seo.title} description={seo.description} lang={lang==='en'?'en':'es-MX'}><Header lang={lang}/><main>
 <section class="detail-hero"><div class="shell"><div class="eyebrow">{t(key,'Hero eyebrow',lang)}</div><h1 class="detail-title v3-wide-title">{t(key,'Hero headline',lang)}</h1><p class="detail-lead">{t(key,'Hero subhead',lang)}</p><Actions lang={lang}/><div class="v3-journey" aria-label="Edge to Cloud"><span>EDGE</span><i></i><span>CORE</span><i></i><span>CLOUD</span></div></div></section>
 <section class="section"><div class="shell detail-copy"><div class="kicker">Edge to Cloud</div><h2>{t(key,'Gap headline',lang)}</h2><p>{t(key,'Gap body',lang)}</p><DataStrip text={t(key,'Data strip',lang)}/></div></section>
 <section class="section v3-promise"><div class="shell"><Rich class="v3-promise-line" text={t(key,'Promise',lang)}/><div class="v3-layer-grid">{items(t(key,'Three layers',lang)).map((layer,i)=><a href={solutionHref(['edge','core','cloud'][i],lang)}><span class="v3-step">0{i+1} ↗</span><h3>{layer.title}</h3><p>{layer.text}</p></a>)}</div><ul class="v3-proof-list">{split(t(key,'Proof box',lang)).map(proof=><li>{proof}</li>)}</ul><p class="v3-lead">{t(key,'IT-team line',lang)}</p></div></section>
 <Questions page={key} lang={lang}/><Stack lang={lang}/><HowWeWork lang={lang}/><CTA lang={lang}/>
 </main><Footer lang={lang}/></BaseLayout>
