---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ContactForm from '../ContactForm.astro';
import CTA from './CTA.astro';
import Actions from './Actions.astro';
import Rich from './Rich.astro';
import { t, tables, split, item, metadata, auditHref, type Lang } from '../../lib/v3';
interface Props { page: 'company' | 'contact' | 'faq'; lang: Lang }
const { page, lang }=Astro.props,en=lang==='en',seo=metadata(page,lang);
const faq=page==='faq';
const heading=faq?split(t(page,'SEO title, meta, hero',lang))[1]:t(page,'Hero headline',lang);
const intro=faq?seo.description:t(page,'Hero subhead',lang);
const faqItems=Object.keys(tables.faq).filter(key=>/^Q\d/.test(key)).map(key=>item(t('faq',key,lang)));
const companyItems=Object.keys(tables.company).filter(key=>/^0\d /.test(key)).map(key=>item(t('company',key,lang)));
const contactSections=en?[
 ['Request your free audit','Receive a vulnerability map, downtime cost model, TCO comparison and architecture recommendation within two weeks.'],
 ['Talk to an expert','A direct conversation about your situation, a specific solution or how we work. No commitment.'],
 ['Contact','atencionaclientes@vialterna.com · +52 55 8062 6884'],
 ['What happens next','We respond within one business day, schedule an initial call and coordinate the audit or the right expert. No automated drip sequences.']
]:[
 ['Solicita tu auditoría gratuita','Recibe mapa de vulnerabilidades, modelo de costo de downtime, comparación TCO y recomendación de arquitectura en dos semanas.'],
 ['Habla con un experto','Una conversación directa sobre tu situación, una solución específica o nuestra forma de trabajo. Sin compromiso.'],
 ['Contacto','atencionaclientes@vialterna.com · +52 55 8062 6884'],
 ['Qué sucede después','Respondemos en un día hábil, hacemos una llamada inicial y coordinamos la auditoría o al experto adecuado. Sin secuencias automatizadas.']
];
const structuredData=faq?{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqItems.map(q=>({'@type':'Question',name:q.title,acceptedAnswer:{'@type':'Answer',text:q.text}}))}:[];
---
<BaseLayout title={seo.title} description={seo.description} lang={en?'en':'es-MX'} structuredData={structuredData}><Header lang={lang}/><main>
 <section class:list={['editorial-hero',page==='company'&&'company-hero']}><div class="shell"><div class="eyebrow">{faq?'FAQ':t(page,'Hero eyebrow',lang)}</div><h1 class="detail-title">{heading}</h1><p class="detail-lead">{intro}</p>{!faq&&<Actions lang={lang}/>}</div></section>
 {page==='contact'&&<ContactForm lang={lang}/>}
 {faq?<section class="section"><div class="shell v3-faq">{faqItems.map((q,i)=><details><summary><span>{String(i+1).padStart(2,'0')}</span>{q.title}<i aria-hidden="true">+</i></summary><Rich text={q.text}/></details>)}</div></section>:page==='company'?<section class="section"><div class="shell editorial-list">{companyItems.map((section,i)=><article><span>0{i+1}</span><h2>{section.title}</h2><p>{section.text}</p>{i===5&&<a class="v3-text-link" href={auditHref(lang)}>{en?'Get your free Telco audit':'Solicita tu auditoría Telco gratuita'} ↗</a>}</article>)}</div></section>:<section class="section"><div class="shell editorial-list">{contactSections.map(([title,text],i)=><article><span>0{i+1}</span><h2>{title}</h2><p>{text}</p>{i===0&&<a class="v3-text-link" href={auditHref(lang)}>{en?'Get your free Telco audit':'Solicita tu auditoría Telco gratuita'} ↗</a>}</article>)}</div></section>}
 {page!=='contact'&&<CTA lang={lang}/>}</main><Footer lang={lang}/></BaseLayout>
